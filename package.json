{
  "name": "kk-studio-next",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "gateway": "node src/features/generation-server/main.ts",
    "test:gateway": "node --test tests/unit/generationServer*.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:ui": "npm run build && node node_modules/@playwright/test/cli.js test",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json design/figma-plugin/*.js design/figma-plugin/*.json config/*.json",
    "ui:check": "node scripts/check-ui-standards.mjs",
    "lint": "eslint src tests scripts *.config.{ts,mjs} --max-warnings 0 && node scripts/check-governance.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run ui:check && npm run format:check && npm run test:ui",
    "tauri": "tauri",
    "client:dev": "tauri dev",
    "client:build": "tauri build",
    "client:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "governance:check": "node scripts/check-governance.mjs",
    "governance:write": "node scripts/check-governance.mjs --write",
    "git:guards": "node scripts/install-git-guards.mjs",
    "delivery:check": "node scripts/check-delivery.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "iconsax-react": "0.0.8",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.13.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
