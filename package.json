{
  "name": "kk-studio",
  "private": true,
  "version": "2.1.45",
  "type": "module",
  "scripts": {
    "postinstall": "npm run agent:install && npm run agent:build && npm run plugins:install && npm run plugins:build",
    "gateway": "node src/features/generation-server/main.ts",
    "local-service": "node src/features/local-service/main.ts",
    "local-service:test": "node tests/local-service/http-integration.mjs",
    "local-service:smoke": "node tests/local-service/production-smoke.mjs",
    "test:gateway": "node --test tests/unit/generationServer*.test.ts",
    "proxy": "node vendor/canvas-proxy/index.js",
    "proxy:test": "node --test tests/unit/proxyForward.test.ts",
    "agent:install": "npm ci --prefix vendor/canvas-agent --ignore-scripts --no-audit --no-fund",
    "agent:build": "node scripts/agent/install-idle-preparation.mjs && node scripts/agent/install-desktop-support.mjs && tsc -p vendor/canvas-agent/tsconfig.json",
    "agent": "npm run agent:build && node scripts/agent/standalone.mjs",
    "agent:package": "npm run agent:build && node scripts/agent/runtime-package.mjs",
    "agent:mcp": "npm run agent:build && node vendor/canvas-agent/dist/index.js mcp",
    "test:agent": "npm run test --prefix vendor/canvas-agent",
    "test:development": "npm run plugins:build && node tests/development/plugins.mjs",
    "plugins:install": "npm ci --prefix vendor/canvas-plugins --ignore-scripts --no-audit --no-fund",
    "plugins:build": "npm --prefix vendor/canvas-plugins run build --workspaces --if-present",
    "dev": "vite",
    "dev:agent": "npm run agent:build && node scripts/agent/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/deploy/*.test.mjs",
    "test:ui": "npm run plugins:build && npm run build && node node_modules/@playwright/test/cli.js test",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json design/figma-plugin/*.js design/figma-plugin/*.json config/*.json \"design/preview/**/*.{ts,tsx,css,html,json}\"",
    "ui:check": "node scripts/check-ui-standards.mjs && npm run design:check && npm run design:lint",
    "lint": "eslint src tests scripts *.config.{ts,mjs} --max-warnings 0 && npm run version:check && npm run version:consistency && node scripts/check-project-goals.mjs && node scripts/check-governance.mjs && node scripts/check-features.mjs && node scripts/check-markdown.mjs && npm run index:check && npm run snapshot:check && npm run doc:commands:check && npm run health:check && npm run footguns:check",
    "verify": "npm run lint && npm run typecheck && npm test && npm run agent:build && npm run test:agent && npm run ui:check && npm run format:check && npm run test:ui && npm run test:design && npm run test:development",
    "tauri": "tauri",
    "client:dev": "tauri dev",
    "client:build": "tauri build",
    "client:build:agent": "npm run agent:package && tauri build --config src-tauri/tauri.agent.conf.json",
    "client:installer": "npm run agent:package && tauri build --config src-tauri/tauri.installer.conf.json",
    "client:installer:receipt": "node scripts/windows/installer-receipt.mjs",
    "client:installer:verify": "node scripts/windows/verify-installer-receipt.mjs",
    "client:installer:test": "node tests/desktop/installer.mjs",
    "client:installed:verify": "node scripts/windows/verify-installed-release.mjs",
    "client:taskhost:test": "node tests/desktop/taskhost-lifecycle.mjs",
    "client:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "client:shortcut": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-shortcut.ps1 -Desktop",
    "governance:check": "node scripts/check-governance.mjs",
    "governance:write": "node scripts/check-governance.mjs --write",
    "goals:check": "node scripts/check-project-goals.mjs",
    "markdown:check": "node scripts/check-markdown.mjs",
    "index:check": "node scripts/check-doc-index.mjs",
    "snapshot:check": "node scripts/check-snapshot-header.mjs",
    "doc:commands:check": "node scripts/check-doc-commands.mjs",
    "delivery:completeness": "node scripts/check-delivery-completeness.mjs",
    "features:check": "node scripts/check-features.mjs",
    "features:write": "node scripts/check-features.mjs --write",
    "version:check": "node scripts/platform-versions.mjs check",
    "version:consistency": "node scripts/check-version-consistency.mjs",
    "version:bump": "node scripts/platform-versions.mjs bump",
    "git:guards": "node scripts/install-git-guards.mjs",
    "delivery:check": "node scripts/check-delivery.mjs",
    "governance:normalize": "node scripts/governance/normalize-ledger.mjs --write",
    "workspace:inventory": "node scripts/governance/workspace-inventory.mjs --write",
    "worktree:reclaim": "node scripts/governance/worktree-reclaim.mjs",
    "worktree:check": "node scripts/governance/worktree-policy.mjs --check-create",
    "health:check": "node scripts/check-code-health.mjs",
    "footguns:check": "node scripts/check-windows-footguns.mjs",
    "design:sync": "node scripts/design-md/cli.mjs sync",
    "design:check": "node scripts/design-md/cli.mjs check",
    "design:lint": "designmd lint DESIGN.md",
    "design:diff": "designmd diff",
    "design:export": "designmd export DESIGN.md --format dtcg",
    "design:spec": "designmd spec --rules",
    "design:dev": "vite --config design/preview/vite.config.ts",
    "design:build": "tsc --noEmit -p design/preview/tsconfig.json && vite build --config design/preview/vite.config.ts",
    "design:preview": "npm run design:build && vite preview --config design/preview/vite.config.ts --host 127.0.0.1 --port 1423 --strictPort",
    "test:design": "node --test tests/unit/designMarkdown.test.ts tests/design-md/documentSource.test.ts && npm run design:build && node node_modules/@playwright/test/cli.js test --config design/preview/playwright.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "iconsax-react": "0.0.8",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.13.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "postcss": "8.5.30",
    "prettier": "^3.9.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "yaml": "^2.9.1"
  }
}
