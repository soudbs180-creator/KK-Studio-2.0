{
  "$description": "KK-Studio-2.0 three-tier design tokens. Tier1 primitive -> Tier2 semantic -> Tier3 component. Source: Ardot canvas 'Design System' (fileId 728457371665311). Companion: docs/DESIGN_TOKENS.md, src/styles/tokens.css",
  "kk": {
    "$extensions": {
      "tierModel": ["primitive", "semantic", "component"],
      "rule": "Higher tiers may only reference lower tiers. Never reference upward. Application code consumes semantic/component tiers only."
