+            <option value="full">全部放行</option>
+          </select>
+        </label>
+      </div>
+      <p className="agent-composer-note">
+        发送文字指令；图片参考请在画布中提供。此处权限仅用于本地 Agent。
+      </p>
+      {feedback && (
+        <p className="agent-action-error" role="alert">
+          {feedback}
+        </p>
+      )}
+      <div className="agent-composer-actions">
+        <button className="ui-button" type="button" onClick={onConfigure}>
+          连接设置
+        </button>
+        <VoiceInputButton
+          value={input}
+          onChange={update}
+          onStatus={setFeedback}
+          enabled={voiceEnabled && !busy}
+          sessionKey={`agent-${draftKey}`}
+          maxLength={7500}
+        />
+        <button
+          className="ui-button is-primary"
+          type="submit"
+          disabled={!ready || busy || !input.trim()}
+          title={
+            !ready
