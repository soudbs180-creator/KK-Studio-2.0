+import { useEffect, useRef, useState } from "react";
+import type { AgentConversationProps } from "./AgentConversationMessages";
+import { readAgentModel } from "../features/agent/agentConnection";
+import VoiceInputButton from "./VoiceInputButton";
+
+export default function AgentComposer({
+  agent,
+  draftKey,
+  onConfigure,
+  voiceEnabled,
+}: {
+  agent: AgentConversationProps;
+  draftKey: string;
+  onConfigure: () => void;
+  voiceEnabled: boolean;
+}) {
+  const [drafts, setDrafts] = useState<Record<string, string>>({});
+  const [feedback, setFeedback] = useState("");
+  const [submitting, setSubmitting] = useState<number | null>(null);
+  const sendingRef = useRef<number | null>(null);
+  useEffect(() => {
+    sendingRef.current = null;
+    setSubmitting(null);
+    setFeedback("");
+  }, [agent.connectionRevision]);
+  const input = drafts[draftKey] ?? "";
+  const busy = submitting === agent.connectionRevision || agent.sending;
+  const preparing =
+    agent.preparing || agent.conversation?.status === "preparing";
+  const ready =
+    agent.connected &&
+    !agent.connecting &&
