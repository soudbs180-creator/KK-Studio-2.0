+import assert from "node:assert/strict";
+import test from "node:test";
+import { setTimeout as delay } from "node:timers/promises";
+import { createAgentConnection } from "../../src/features/agent/agentConnection.ts";
+import { startAgentServer } from "../helpers/agentServer.ts";
+
+async function connected(conn: ReturnType<typeof createAgentConnection>) {
+  await conn.connect();
+  for (let i = 0; i < 100 && conn.getState().status === "connecting"; i++)
+    await delay(10);
+  assert.equal(
+    conn.getState().status,
+    "connected",
+    conn.getState().error ?? "hello handshake did not finish",
+  );
+}
+
+test("conditional preparation preserves another window's newly prepared thread", async (t) => {
+  const server = await startAgentServer("idle");
+  let release!: () => void;
+  let requested!: () => void;
+  const held = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  const started = new Promise<void>((resolve) => {
+    requested = resolve;
+  });
+  const conn = createAgentConnection({
+    fetcher: (async (url, init) => {
+      if (String(url).endsWith("/conversation/prepare")) {
+        requested();
+        await held;
+      }
+      return fetch(url, init);
+    }) as typeof fetch,
+  });
+  t.after(async () => {
+    release();
+    conn.disconnect();
+    await server.close();
+  });
+  conn.setCredentials(server.url, "fixture-token");
+  await connected(conn);
+  const pending = conn.prepareConversation();
+  await started;
+  server.emit("conversation_changed", {
+    revision: 2,
+    conversationId: "other-conversation",
+    threadId: "other-thread",
+    status: "ready",
+    mcpStatuses: {},
+  });
+  release();
+  const result = await pending;
+  assert.equal(result.ok, false);
+  assert.match(result.error ?? "", /保留现有会话/);
+  assert.equal(server.conversation().threadId, "other-thread");
+  assert.equal(conn.getState().conversation?.threadId, "other-thread");
+  assert.equal(server.requests.includes("/agent/codex/threads/new"), false);
+});
+
+test("old services fail closed without falling back to unconditional thread replacement", async (t) => {
+  const server = await startAgentServer("idle", false);
+  const conn = createAgentConnection();
+  t.after(async () => {
+    conn.disconnect();
+    await server.close();
+  });
+  conn.setCredentials(server.url, "fixture-token");
+  await connected(conn);
+  const result = await conn.prepareConversation();
+  assert.equal(result.ok, false);
+  assert.match(result.error ?? "", /不支持安全准备/);
+  assert.equal(server.requests.includes("/agent/codex/threads/new"), false);
+  assert.equal(server.conversation().status, "idle");
+});
+
+for (const status of ["ready", "warning", "idle"] as const) {
+  test(`vendor named hello establishes ${status} without a conversation_changed replay`, async (t) => {
+    const server = await startAgentServer(status);
+    const conn = createAgentConnection();
+    t.after(async () => {
+      conn.disconnect();
+      await server.close();
+    });
+    conn.setCredentials(server.url, "fixture-token");
+    await connected(conn);
+    assert.equal(conn.getState().conversation?.status, status);
+    assert.ok(
+      server.requests.indexOf("/events") <
+        server.requests.indexOf("/canvas/activate"),
+    );
+    assert.ok(
+      server.requests.indexOf("/canvas/activate") <
+        server.requests.indexOf("/canvas/state"),
+    );
+    assert.equal(
+      server.requests.includes("/agent/codex/threads/new"),
+      false,
+      "connect must not reset a session",
+    );
+    if (status === "idle") {
+      assert.equal(
+        (await conn.sendMessage("blocked until prepared")).ok,
+        false,
+      );
+      assert.equal((await conn.prepareConversation()).ok, true);
+      assert.equal(conn.getState().conversation?.status, "ready");
+      assert.equal(
+        (await conn.prepareConversation()).ok,
+        false,
+        "cannot replace an existing session",
+      );
+    }
+    assert.equal((await conn.sendMessage("读取画布")).ok, true);
+    assert.equal(server.turns.length, 1);
+    server.emit("codex_approval", { requestId: "a", method: "shell" });
+    for (let i = 0; i < 100 && !conn.getState().pendingApproval; i++)
+      await delay(10);
+    assert.equal(conn.getState().pendingApproval?.requestId, "a");
+    assert.equal(
+      conn.getState().sending,
+      true,
+      "user echo is not turn completion",
+    );
+    assert.equal((await conn.interrupt()).ok, true);
+    for (let i = 0; i < 100 && conn.getState().sending; i++) await delay(10);
+    assert.equal(conn.getState().sending, false);
+  });
+}
