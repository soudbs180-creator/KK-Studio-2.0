+    <section className="prompt-library-panel">
+      <header className="prompt-library-header">
+        <div>
+          <h2>提示词库</h2>
+          <p>选用公开提示词，加入{target}后继续编辑。</p>
+        </div>
+        <button
+          className="ui-icon-button"
+          type="button"
+          aria-label="关闭提示词库"
+          onClick={onClose}
+        >
