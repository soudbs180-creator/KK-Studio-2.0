+/* DS 1.3: the only geometry owner for home and conversation inputs.
+   Canvas node editors and ordinary fields have separate contracts. */
+.composer-surface {
+  --composer-target: 32px;
+  --composer-font: var(--ui-font-label);
+  --composer-line: 20px;
+  --composer-min-lines: 3;
+  --composer-max-lines: 8;
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  height: auto;
+  flex: 0 0 auto;
+  gap: var(--ui-space-2);
+  padding: var(--ui-space-3);
+  border: var(--ui-border-width) solid var(--border-control);
+  border-radius: var(--ui-radius-panel);
+  background: var(--bg-input);
+  color: var(--text-primary);
+  text-align: left;
+  outline: none;
+}
+.start-composer {
+  width: 1052.344px;
+  max-width: calc(100% - 48px);
+}
+.conversation-panel .chat-composer {
+  width: 100%;
+  margin: 0;
+}
+.composer-surface:has(> .composer-textarea:focus) {
+  outline: var(--ui-focus-width) solid var(--focus-ring);
+  outline-offset: var(--ui-focus-offset);
+}
+.composer-surface > .composer-textarea {
+  display: block;
+  width: 100%;
+  min-width: 0;
+  min-height: calc(var(--composer-line) * var(--composer-min-lines));
+  max-height: calc(var(--composer-line) * var(--composer-max-lines));
+  flex: 0 0 auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: var(--text-primary);
+  font: inherit;
+  font-size: var(--composer-font);
+  line-height: var(--composer-line);
+  overflow-y: auto;
+  overflow-wrap: anywhere;
+  resize: none;
+  outline: none;
+  scrollbar-width: thin;
+  overscroll-behavior: contain;
+}
+.composer-textarea::placeholder {
+  color: var(--text-tertiary);
+  opacity: 1;
+}
+.composer-textarea:disabled {
+  opacity: var(--ui-disabled-opacity);
+  cursor: not-allowed;
+}
+.composer-toolbar {
+  display: flex;
+  align-items: center;
+  gap: var(--ui-space-1);
+  width: 100%;
+  min-width: 0;
+  flex: 0 0 auto;
+}
+.start-footer-left,
+.start-footer-right {
+  display: contents;
+}
+.start-model-picker,
+.chat-model-picker-wrap,
+.start-resource-picker,
+.chat-resource-picker,
+.start-mode-picker,
+.chat-mode-menu {
+  position: relative;
+  display: flex;
+  align-items: center;
+  flex: 0 0 auto;
+  min-width: 0;
+}
+.composer-toolbar
+  :is(
+    .start-tool-button,
+    .chat-model-picker,
+    .chat-skill-trigger,
+    .chat-plugin-trigger,
+    .chat-mode-trigger,
+    .start-mode-button
+  ) {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  height: var(--composer-target);
+  min-width: 0;
+  gap: var(--ui-space-1);
+  padding: 0 var(--ui-space-2);
+  border-radius: var(--ui-radius-pill);
+  background: var(--bg-elevated);
+  color: var(--text-secondary);
+  font-size: var(--ui-font-body);
+  line-height: var(--ui-line-height-body);
+  white-space: nowrap;
+}
+.composer-toolbar
+  :is(
+    .start-add-button,
+    .chat-attachment-trigger,
+    [data-voice-state],
+    .start-submit-button,
+    .chat-send
+  ) {
+  display: grid;
+  place-items: center;
+  flex: 0 0 var(--composer-target);
+  width: var(--composer-target);
+  height: var(--composer-target);
+  min-width: var(--composer-target);
+  margin: 0;
+  padding: 0;
+  border-radius: var(--ui-radius-control);
+  background: transparent;
+}
+.composer-toolbar button:hover:not(:disabled),
+.composer-toolbar button[aria-expanded="true"] {
+  color: var(--text-primary);
+  background: var(--neutral-selected);
+}
+.composer-toolbar button:active:not(:disabled) {
+  background: var(--bg-soft);
+}
+.composer-toolbar :is(.start-model-picker, .chat-model-picker-wrap) {
+  order: 2;
+  flex: 1 1 110px;
+  max-width: 260px;
+  min-width: 80px;
+}
+.chat-composer .chat-model-picker-wrap {
+  max-width: 110px;
+}
+.composer-toolbar :is(.start-model-picker > button, .chat-model-picker) {
+  width: 100%;
+  justify-content: flex-start;
+}
+.composer-toolbar :is(.start-model-picker > button > span, .chat-model-name) {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  text-align: left;
+}
+.composer-toolbar :is(.start-add-button, .chat-attachment-trigger) {
+  order: 1;
+}
+.composer-toolbar :is(.composer-skill, .chat-skill-picker) {
+  order: 3;
+}
+.composer-toolbar :is(.composer-plugin, .chat-plugin-picker) {
+  order: 4;
+}
+.composer-toolbar [data-voice-state] {
+  order: 5;
+  margin-left: auto;
+}
+.composer-toolbar :is(.start-mode-picker, .chat-mode-menu) {
+  order: 6;
+}
+.composer-toolbar :is(.start-submit-button, .chat-send) {
+  order: 7;
+}
+.composer-toolbar :is(.start-composer-divider, .chat-footer-separator) {
+  display: none;
+}
+.composer-toolbar
+  :is(
+    .start-tool-button,
+    .chat-model-picker,
+    .chat-skill-trigger,
+    .chat-plugin-trigger,
+    [data-voice-state]
+  )
+  > img {
+  display: block;
+  flex: 0 0 16px;
+  width: 16px;
+  height: 16px;
+  object-fit: contain;
+}
+.composer-toolbar
+  :is(
+    .start-add-button,
+    .chat-attachment-trigger,
+    .start-submit-button,
+    .chat-send
+  )
+  > img {
+  display: block;
+  width: 20px;
+  height: 20px;
+  object-fit: contain;
+}
+.composer-toolbar :is(.start-mode-button, .chat-mode-trigger) > img {
+  display: block;
+  flex: 0 0 10px;
+  width: 10px;
+  height: 6px;
+  object-fit: contain;
+}
+.composer-surface .start-attachment-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--ui-space-2);
+  width: 100%;
+  min-width: 0;
+  margin: 0;
+}
+.composer-surface .start-attachment-chip {
+  display: flex;
+  align-items: center;
+  flex: 0 1 calc(50% - 4px);
+  min-width: 0;
+  max-width: 280px;
+  gap: var(--ui-space-1);
+  padding: 0 0 0 var(--ui-space-1);
+  border: var(--ui-border-width) solid var(--border-default);
+  border-radius: var(--ui-radius-control);
+  background: var(--bg-elevated);
+  font-size: var(--ui-font-body);
+  color: var(--text-secondary);
+}
+.start-attachment-chip > img {
+  width: 24px;
+  height: 24px;
+  flex: 0 0 24px;
+  border-radius: var(--ui-space-1);
+  object-fit: cover;
+}
+.start-attachment-chip > span {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+.composer-surface .start-attachment-chip > button {
+  display: grid;
+  place-items: center;
+  width: var(--composer-target);
+  height: var(--composer-target);
+  flex: 0 0 var(--composer-target);
+  padding: 0;
+  border-radius: var(--ui-radius-control);
+  color: var(--text-secondary);
+  font-size: var(--ui-font-title);
+}
+.composer-surface .kk-model-variants {
+  margin: 0;
+  gap: var(--ui-space-2);
+  min-width: 0;
+}
+.composer-surface .kk-model-variants select {
+  min-height: var(--composer-target);
+  border-radius: var(--ui-radius-control);
+  border-color: var(--border-control);
+}
+.composer-options {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: var(--ui-space-2);
+  width: 100%;
+  max-width: 540px;
+  min-width: 0;
+}
+.start-count-picker {
+  display: flex;
+  align-items: center;
+  min-width: 0;
+  gap: var(--ui-space-2);
+  padding: 0 var(--ui-space-2);
+  border: var(--ui-border-width) solid var(--border-default);
+  border-radius: var(--ui-radius-control);
+  color: var(--text-secondary);
+  font-size: var(--ui-font-body);
+  white-space: nowrap;
+}
+.start-count-picker > select {
+  width: 100%;
+  min-width: 0;
+  height: var(--composer-target);
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--text-primary);
+  font-size: var(--ui-font-body);
+}
+@media (max-width: 1200px) {
+  .composer-surface {
+    --composer-target: 44px;
+    --composer-font: var(--ui-font-title);
+    --composer-line: 24px;
+  }
+  .start-composer {
+    max-width: 100%;
+  }
+  .composer-toolbar {
+    display: grid;
+    grid-template-columns: 44px 44px minmax(0, 1fr) 64px 64px;
+    gap: var(--ui-space-1);
+    row-gap: var(--ui-space-2);
+  }
+  .composer-toolbar :is(.start-model-picker, .chat-model-picker-wrap) {
+    grid-area: 1 / 1 / 2 / 4;
+    min-width: 0;
+    max-width: none;
+  }
+  .composer-toolbar :is(.composer-skill, .chat-skill-picker) {
+    grid-area: 1 / 4;
+  }
+  .composer-toolbar :is(.composer-plugin, .chat-plugin-picker) {
+    grid-area: 1 / 5;
+  }
+  .composer-toolbar
+    :is(.start-resource-picker, .chat-resource-picker)
+    > button {
+    width: 100%;
+  }
+  .composer-toolbar :is(.start-add-button, .chat-attachment-trigger) {
+    grid-area: 2 / 1;
+  }
+  .composer-toolbar [data-voice-state] {
+    grid-area: 2 / 2;
+    margin-left: 0;
+  }
+  .composer-toolbar :is(.start-mode-picker, .chat-mode-menu) {
+    grid-area: 2 / 3 / 3 / 5;
+    justify-self: end;
+  }
+  .composer-toolbar :is(.start-mode-button, .chat-mode-trigger) {
+    min-width: 72px;
+  }
+  .composer-toolbar :is(.start-submit-button, .chat-send) {
+    grid-area: 2 / 5;
+    justify-self: end;
+  }
+}
+@media (min-width: 768px) and (max-width: 1200px) {
+  /* A wide home surface has room for one row; the narrow chat rail does not. */
+  .start-composer .composer-toolbar {
+    display: flex;
+  }
+  .start-composer .start-model-picker {
+    min-width: 80px;
+    max-width: 260px;
+  }
+  .start-composer [data-voice-state] {
+    margin-left: auto;
+  }
+}
+@media (max-height: 600px) {
+  .composer-surface {
+    --composer-min-lines: 2;
+    --composer-max-lines: 4;
+  }
+}
