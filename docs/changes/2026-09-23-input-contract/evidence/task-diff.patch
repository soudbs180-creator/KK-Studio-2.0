+  border-radius: var(--ui-radius-pill);
+  background: var(--bg-card);
+  color: var(--text-secondary);
+  font-size: var(--ui-font-caption);
+  line-height: var(--ui-line-height-caption);
+}
+.skill-card-title-row,
+.workflow-card-title-row {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 10px;
+}
+.skill-card-title-row strong,
+.workflow-card-title-row strong {
+  min-width: 0;
+}
+.skill-card-actions,
+.workflow-card-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+.skill-card-actions .is-installed {
+  color: var(--ui-success);
+}
+.skill-editor label {
+  display: grid;
+  gap: var(--ui-space-1);
+  min-width: 0;
+  font-size: var(--ui-font-body);
+  line-height: var(--ui-line-height-body);
+}
+.skill-editor h2 {
+  font-size: var(--ui-font-title);
+  line-height: var(--ui-line-height-title);
+}
+.skill-editor p {
+  color: var(--text-secondary);
+  font-size: var(--ui-font-body);
+  line-height: var(--ui-line-height-body);
+}
+@media (max-width: 1100px) {
+  .catalog-page {
+    padding: 36px 28px 60px;
+  }
+  .catalog-card-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .project-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .start-inspiration-grid {
+    grid-template-columns: 1fr;
+    max-width: 520px;
+  }
+  .start-inspiration-card {
+    display: grid;
+    grid-template-columns: 170px 1fr;
+  }
+  .start-inspiration-card img {
+    height: 100%;
+  }
+  .project-library-hero {
+    padding-right: 24px;
+  }
+}
+@media (max-width: 620px) {
+  .start-page,
+  .catalog-page {
+    padding: 28px 18px 46px;
+  }
+  /* The stacked footer leaves no room above the trigger rows: upward popovers
+     cover the textarea (blocking outside-click dismissal) while trigger-row
+     anchored downward popovers cover sibling triggers. Anchor every composer
+     popover to the whole footer so it opens beneath the controls instead. */
+  .start-skill-popover,
+  .start-plugin-popover,
+  .start-model-popover,
+  .start-mode-popover {
+    top: calc(100% + 10px);
+    bottom: auto;
+  }
+  .start-brand {
+    margin-top: 28px;
+  }
+  .start-brand p {
+    font-size: 13px;
+  }
+  .start-discovery {
+    margin-top: 42px;
+  }
+  .catalog-page-header,
+  .catalog-page-toolbar {
+    align-items: stretch;
+    flex-direction: column;
+  }
+  .catalog-page-actions {
+    flex-wrap: wrap;
+  }
+  .catalog-page-actions .primary-button,
+  .catalog-page-actions .ui-button {
+    flex: 1;
+  }
+  .catalog-page-search {
+    width: 100%;
+  }
+  .catalog-card-grid,
+  .project-grid {
+    grid-template-columns: 1fr;
+  }
+  .catalog-card-body p {
+    min-height: unset;
+  }
+  .project-library-hero {
+    height: 110px;
+    padding: 12px;
+  }
+  .project-library-actions {
+    grid-template-columns: 1fr;
+    gap: 8px;
+  }
+  .project-hero-tile {
+    width: 62px;
+    height: 50px;
+    font-size: 20px;
+  }
+  .project-hero-orb {
+    font-size: 36px;
+  }
+  .start-inspiration-card {
+    grid-template-columns: 120px 1fr;
+  }
+  .start-inspiration-card > div {
+    padding: 11px;
+  }
+  .start-inspiration-card strong {
+    font-size: 14px;
+  }
+}
