+          for (let j = i + 1; j < boxes.length; j++) {
+            const b = boxes[j]!;
+            const area =
+              Math.max(
+                0,
+                Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x),
+              ) *
+              Math.max(
+                0,
+                Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y),
+              );
+            expect(area, `${selectors[i]} overlaps ${selectors[j]}`).toBe(0);
