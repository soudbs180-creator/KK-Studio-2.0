{
  "name": "kk-recovery-branch-safety",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/archive",
        "refs/heads/archive/**",
        "refs/heads/backup",
        "refs/heads/backup/**"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    }
  ]
}
